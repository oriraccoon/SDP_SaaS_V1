rules_version = '2';

// 적용 방법: Firebase 콘솔 > Firestore Database > 규칙 탭에 전체 내용을 붙여 넣고 게시합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // admins 컬렉션에 본인 계정 ID 문서가 있으면 관리자입니다. (문서는 콘솔에서만 만듭니다)
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 계정별 설정 (행 선택, 대치 사전, 연동 설정). 엑셀 주문 데이터는 저장하지 않습니다.
    match /users/{uid}/settings/{settingId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      // 관리자는 휴지통에서 영구 삭제할 때 회원 설정을 지울 수 있습니다.
      allow delete: if isAdmin();
    }

    // 초대 문서에 적힌 설정 (문서 ID는 이메일 주소)
    function invite(email) {
      return get(/databases/$(database)/documents/invites/$(email)).data;
    }

    // ---- 회원 문서(users/{uid}) 검사용 ----
    // 회원 문서 필드 (앱이 쓰는 것):
    //   email: string (로그인 이메일) / lastLoginAt: string (ISO 시각)
    //   expiresAt: string|null, features: map, blocked: bool, deletedAt: string|null  (관리자 또는 초대만)
    //   uploadLimit: int|null (월 업로드 한도, 없거나 null이면 제한 없음. 관리자만 설정, 예전 무료 플랜 회원에게 남아 있음)
    //   trialStartedAt: timestamp (무료 체험 시작 시각. 본인이 한 번만 서버 시각 그대로 기록)
    //   usage: { month: 'YYYY-MM', count: int } (이번 달 업로드 사용량. 본인은 늘리기만 가능)

    // 시각을 'YYYY-MM' 달 키로 바꿉니다.
    function monthKey(t) {
      let m = t.month();
      return string(t.year()) + '-' + (m < 10 ? '0' + string(m) : string(m));
    }

    // 앱은 사용자 컴퓨터 시각으로 달을 정합니다. 국제 표준시(UTC)와 한국 시각(UTC+9)의 이번 달을 허용합니다.
    function isThisMonth(key) {
      return key == monthKey(request.time) || key == monthKey(request.time + duration.value(9, 'h'));
    }

    // 로그인 시각은 짧은 글자여야 합니다.
    function isValidLoginAt(data) {
      return !('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 40);
    }

    // 업로드 사용량: 이번 달 기록이고, 한도를 넘지 않고, 같은 달이면 늘어나기만 합니다.
    // (줄이거나 0으로 되돌리거나 지난달·다음 달로 바꾸는 것은 막습니다)
    function isValidUsageIncrease() {
      let before = resource.data.get('usage', null);
      let u = request.resource.data.get('usage', null);
      let limit = request.resource.data.get('uploadLimit', null);
      return u is map
        && u.keys().hasOnly(['month', 'count']) && u.keys().hasAll(['month', 'count'])
        && u.month is string && isThisMonth(u.month)
        && u.count is int && u.count >= 1 && u.count <= 100000
        && (limit == null || u.count <= limit)
        && (
          !(before is map)
          || (before.get('month', '') == u.month && u.count > before.get('count', 0))
          || (before.get('month', '') != u.month && u.month > before.get('month', ''))
        );
    }

    // 회원 기본 정보: 이메일, 마지막 접속, 구독 만료일, 정지 여부, 기능 설정
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // 본인은 로그인 시각만 갱신할 수 있습니다.
      // 처음 만들 때는 기본 정보만 쓰거나, 본인 이메일로 된 초대의 설정(기간·기능·정지)을 그대로 받을 수 있습니다.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.email == request.auth.token.email
        && isValidLoginAt(request.resource.data)
        && (
          request.resource.data.keys().hasOnly(['email', 'lastLoginAt'])
          || (
            request.resource.data.keys().hasOnly(['email', 'lastLoginAt', 'expiresAt', 'features', 'blocked'])
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.email))
            && invite(request.resource.data.email).expiresAt == request.resource.data.expiresAt
            && invite(request.resource.data.email).features == request.resource.data.features
            && invite(request.resource.data.email).blocked == request.resource.data.blocked
          )
        );
      // 이미 가입한 계정도, 본인 이메일로 된 초대가 있으면 초대 설정(기간·기능·정지)을 한 번 받을 수 있습니다.
      allow update: if (isSignedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'lastLoginAt'])
          && (request.resource.data.get('email', null) == resource.data.get('email', null)
            || request.resource.data.email == request.auth.token.email)
          && isValidLoginAt(request.resource.data))
        || (isSignedIn() && request.auth.uid == uid
          && request.auth.token.email_verified == true
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'lastLoginAt', 'expiresAt', 'features', 'blocked'])
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.email))
          && invite(request.resource.data.email).expiresAt == request.resource.data.expiresAt
          && invite(request.resource.data.email).features == request.resource.data.features
          && invite(request.resource.data.email).blocked == request.resource.data.blocked)
        // 본인은 이번 달 업로드 사용량(usage)을 늘리기만 할 수 있습니다.
        // 무료 체험은 체험·구독 기간·월 한도가 모두 없는 계정만 한 번 시작할 수 있고, 시작 시각은 서버 시각이어야 합니다.
        || (isSignedIn() && request.auth.uid == uid
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usage'])
              && isValidUsageIncrease())
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trialStartedAt'])
              && !('trialStartedAt' in resource.data)
              && !('uploadLimit' in resource.data)
              && resource.data.get('expiresAt', null) == null
              && request.resource.data.trialStartedAt == request.time)))
        || isAdmin();
      // 관리자는 휴지통에서 영구 삭제할 때 회원 정보를 지울 수 있습니다.
      allow delete: if isAdmin();
    }

    // 회원 초대: 관리자가 만들고, 초대받은 본인이 처음 로그인할 때 지웁니다.
    match /invites/{email} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email == email);
      allow create, update: if isAdmin();
      allow delete: if isAdmin()
        || (isSignedIn() && request.auth.token.email_verified == true && resource.data.email == request.auth.token.email);
    }

    // 관리자 목록: 본인 문서만 읽을 수 있고, 앱에서는 쓸 수 없습니다.
    match /admins/{adminUid} {
      allow read: if isSignedIn() && request.auth.uid == adminUid;
      allow write: if false;
    }

    // 랜딩 페이지 질문(FAQ): 로그인 전에도 누구나 읽을 수 있고, 관리자만 고칩니다.
    match /config/faq {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 공지 배너: 로그인한 회원은 읽고, 관리자만 씁니다.
    match /config/notice {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 문의/버그 신고: 회원은 보내기만 가능합니다. 읽기와 처리 상태 변경은 관리자만 합니다.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['category', 'message', 'uid', 'email', 'pageUrl', 'userAgent', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }
  }
}
